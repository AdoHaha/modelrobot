<?xml version="1.0"?>
<robot name="mimic_parallel_gripper">
  <link name="palm">
    <visual><geometry><box size="0.12 0.24 0.06"/></geometry><material name="metal"><color rgba="0.28 0.37 0.46 1"/></material></visual>
  </link>
  <link name="left_finger">
    <visual><origin xyz="0.105 0 0.035"/><geometry><box size="0.21 0.026 0.07"/></geometry><material name="blue"><color rgba="0.14 0.52 0.76 1"/></material></visual>
    <visual><origin xyz="0.19 -0.0195 0.035"/><geometry><box size="0.04 0.013 0.07"/></geometry><material name="dark"><color rgba="0.12 0.14 0.17 1"/></material></visual>
  </link>
  <link name="right_finger">
    <visual><origin xyz="0.105 0 0.035"/><geometry><box size="0.21 0.026 0.07"/></geometry><material name="blue"><color rgba="0.14 0.52 0.76 1"/></material></visual>
    <visual><origin xyz="0.19 0.0195 0.035"/><geometry><box size="0.04 0.013 0.07"/></geometry><material name="dark"><color rgba="0.12 0.14 0.17 1"/></material></visual>
  </link>
  <joint name="left_finger_joint" type="prismatic">
    <parent link="palm"/><child link="left_finger"/><origin xyz="0 0.104 0"/>
    <axis xyz="0 -1 0"/><limit lower="0" upper="0.075" effort="100" velocity="0.2"/>
  </joint>
  <joint name="right_finger_joint" type="prismatic">
    <parent link="palm"/><child link="right_finger"/><origin xyz="0 -0.104 0"/>
    <axis xyz="0 1 0"/><limit lower="0" upper="0.075" effort="100" velocity="0.2"/>
    <mimic joint="left_finger_joint" multiplier="1" offset="0"/>
  </joint>
</robot>
